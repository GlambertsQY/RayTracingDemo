#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require

#include "shared/common.glsl"
#include "shared/brdf.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT gTlas;

layout(location = 0) rayPayloadEXT HitPayload gPayload;

// 阴影射线使用 ray query，命中任意不透明表面即视为遮挡
bool traceOcclusion(vec3 origin, vec3 direction, float maxDistance)
{
    if (!isFiniteVec(origin) || !isFiniteVec(direction) || !(maxDistance > 0.0))
    {
        return false;
    }

    rayQueryEXT query;
    rayQueryInitializeEXT(query, gTlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF, origin,
                          0.005, direction, maxDistance);
    while (rayQueryProceedEXT(query))
    {
    }
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
    // DEBUG: return false;
}

vec3 explicitLighting(vec3 hitPos, vec3 normal, vec3 diffuseAlbedo)
{
    vec3 result = vec3(0.0);
    if (!isFiniteVec(hitPos) || !isFiniteVec(normal) || dot(normal, normal) < 1e-8)
    {
        return result;
    }

    const vec3 sunDirection = normalize(fc.sunDir.xyz);
    const float sunCos = dot(normal, sunDirection);
    if (sunCos > 0.0 && fc.sunColor.w > 0.0)
    {
        if (!traceOcclusion(hitPos + normal * 0.005, sunDirection, 1e30))
        {
            result += diffuseAlbedo * kInvPi * fc.sunColor.rgb * fc.sunColor.w * sunCos;
        }
    }

    const int lightCount = int(fc.lightCount);
    for (int i = 0; i < lightCount; ++i)
    {
        const GpuLight light = gLights[i];

        vec3 surfacePoint;
        vec3 lightNormal;
        float area;
        if (light.position.w < 0.5)
        {
            surfacePoint = light.position.xyz + light.u.xyz * (rand() * 2.0 - 1.0) +
                           light.v.xyz * (rand() * 2.0 - 1.0);
            lightNormal = normalize(cross(light.u.xyz, light.v.xyz));
            area = 4.0 * length(cross(light.u.xyz, light.v.xyz));
        }
        else
        {
            const vec3 offset = randomUnitVector();
            surfacePoint = light.position.xyz + offset * light.emission.w;
            lightNormal = offset;
            area = 4.0 * kPi * light.emission.w * light.emission.w;
        }

        vec3 toLight = surfacePoint - hitPos;
        const float distanceSquared = max(dot(toLight, toLight), 1e-6);
        const float distance = sqrt(distanceSquared);
        toLight /= distance;

        const float surfaceCos = dot(normal, toLight);
        if (surfaceCos <= 0.0)
        {
            continue;
        }

        const float lightCos = light.position.w < 0.5 ? abs(dot(lightNormal, -toLight))
                                                      : max(dot(lightNormal, -toLight), 0.0);
        if (lightCos <= 0.0)
        {
            continue;
        }

        if (traceOcclusion(hitPos + normal * 0.005, toLight, max(distance - 0.01, 0.001)))
        {
            continue;
        }

        result += diffuseAlbedo * kInvPi * light.emission.rgb * surfaceCos * lightCos * area / distanceSquared;
    }

    return result;
}

void main()
{
    const ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    const int sampleCount = max(int(fc.samplesPerFrame), 1);
    vec3 total = vec3(0.0);

    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex)
    {
        seedRng(gl_LaunchIDEXT, uint(sampleIndex));

        const vec2 jitter = vec2(rand(), rand());
        vec2 ndc = ((vec2(pixel) + jitter) / fc.resolution) * 2.0 - 1.0;
        ndc.y = -ndc.y;

        const float aspect = fc.resolution.x / max(fc.resolution.y, 1.0);
        const float tanHalf = tan(fc.fov * 0.5);
        const vec3 rayDirection = normalize(fc.camForward.xyz + ndc.x * tanHalf * aspect * fc.camRight.xyz +
                                            ndc.y * tanHalf * fc.camUp.xyz);

        vec3 origin = fc.camPos.xyz;
        vec3 direction = rayDirection;
        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);

        const int maxBounces = max(int(fc.maxBounces), 1);
        for (int bounce = 0; bounce < maxBounces; ++bounce)
        {
            gPayload.t = -1.0;
            gPayload.instance = 0xFFFFFFFFu;
            gPayload.primitive = 0u;
            gPayload.normal = vec3(0.0);
            gPayload.uv = vec2(0.0);

            traceRayEXT(gTlas, gl_RayFlagsNoneEXT, 0xFF, 0u, 0u, 0u, origin, 0.005, direction, 1e30, 0);

            if (gPayload.t < 0.0)
            {
                radiance += throughput * skyRadiance(direction);
                break;
            }

            const vec3 hitPosition = origin + direction * gPayload.t;
            const vec3 geometricNormal = normalize(gPayload.normal);
            vec3 normal = geometricNormal;
            const vec3 view = -direction;
            if (dot(normal, view) < 0.0)
            {
                normal = -normal;
            }

            if (!isFiniteVec(normal) || dot(normal, normal) < 1e-8)
            {
                break;
            }

            const GpuMaterial material = getMaterial(gPayload.instance);

            vec4 base = material.baseColor;
            if (material.baseColorTex >= 0)
            {
                base *= sampleTexture(material.baseColorTex, gPayload.uv);
            }

            vec2 metallicRoughness = vec2(1.0);
            if (material.mrTex >= 0)
            {
                // glTF: G = roughness, B = metallic
                metallicRoughness = sampleTexture(material.mrTex, gPayload.uv).gb;
            }

            const vec3 albedo = base.rgb;
            const float metallic = clamp(material.metallic * metallicRoughness.y, 0.0, 1.0);
            const float roughness = clamp(material.roughness * metallicRoughness.x, 0.03, 1.0);
            const vec3 diffuseAlbedo = albedo * (1.0 - metallic);
            const bool isGlass = material.emissive.w > 0.5;

            radiance += throughput * material.emissive.rgb;

            if (!isGlass && metallic < 0.5)
            {
                radiance += throughput * explicitLighting(hitPosition, normal, diffuseAlbedo);
            }

            const bool entering = dot(geometricNormal, direction) < 0.0;
            const vec3 refractionNormal = entering ? geometricNormal : -geometricNormal;
            const float nDotV = max(dot(refractionNormal, -direction), 1e-3);

            if (isGlass)
            {
                const float fresnel = fresnelDielectric(nDotV, material.ior);
                vec3 nextDirection;
                if (rand() < fresnel)
                {
                    nextDirection = reflect(direction, refractionNormal);
                }
                else
                {
                    const float eta = entering ? (1.0 / material.ior) : material.ior;
                    nextDirection = refract(direction, refractionNormal, eta);
                    if (dot(nextDirection, nextDirection) < 1e-6 || any(isnan(nextDirection)))
                    {
                        nextDirection = reflect(direction, refractionNormal);
                    }
                }
                direction = normalize(nextDirection);
                origin = hitPosition + direction * 0.005;
            }
            else if (metallic > 0.5)
            {
                vec3 weight;
                vec3 nextDirection;
                if (!sampleMetallicBrdf(normal, view, albedo, roughness, nextDirection, weight))
                {
                    break;
                }
                throughput *= weight;
                direction = nextDirection;
                origin = hitPosition + direction * 0.005;
            }
            else
            {
                direction = cosineHemisphere(normal);
                throughput *= diffuseAlbedo;
                origin = hitPosition + direction * 0.005;
            }

            if (!isFiniteVec(direction) || dot(direction, direction) < 1e-8)
            {
                break;
            }

            if (bounce >= 3)
            {
                const float survival = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
                if (rand() > survival)
                {
                    break;
                }
                throughput /= survival;
            }
        }

        total += radiance;
    }

    imageStore(gRadianceImage, pixel, vec4(total / float(sampleCount), 1.0));
}
