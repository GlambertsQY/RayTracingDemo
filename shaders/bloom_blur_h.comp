#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 12, rgba16f) uniform image2D gSrcImage;
layout(set = 0, binding = 13, rgba16f) uniform image2D gDstImage;

const float kWeights[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(gSrcImage);
    if (pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }

    vec3 color = imageLoad(gSrcImage, pixel).rgb * kWeights[0];
    for (int i = 1; i < 5; ++i)
    {
        color += imageLoad(gSrcImage, clamp(pixel + ivec2(i, 0), ivec2(0), size - 1)).rgb * kWeights[i];
        color += imageLoad(gSrcImage, clamp(pixel - ivec2(i, 0), ivec2(0), size - 1)).rgb * kWeights[i];
    }
    imageStore(gDstImage, pixel, vec4(color, 1.0));
}
