#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "shared/common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(fc.resolution.x) || pixel.y >= int(fc.resolution.y))
    {
        return;
    }

    vec3 sampleColor = imageLoad(gRadianceImage, pixel).rgb;
    // 按亮度裁剪并保持色度，避免逐通道裁剪导致高光偏色
    const float luminance = dot(sampleColor, vec3(0.2126, 0.7152, 0.0722));
    const float clampLuminance = max(fc.fireflyClamp, 0.1);
    if (luminance > clampLuminance)
    {
        sampleColor *= clampLuminance / luminance;
    }

    const vec4 previous = imageLoad(gAccumImage, pixel);
    imageStore(gAccumImage, pixel, vec4(previous.rgb + sampleColor, previous.a + 1.0));
}
