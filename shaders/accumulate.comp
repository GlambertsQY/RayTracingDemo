#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "shared/common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(fc.resolution.x) || pixel.y >= int(fc.resolution.y))
    {
        return;
    }

    vec3 sampleColor = imageLoad(gRadianceImage, pixel).rgb;
    sampleColor = min(sampleColor, vec3(max(fc.fireflyClamp, 0.1)));

    const vec4 previous = imageLoad(gAccumImage, pixel);
    imageStore(gAccumImage, pixel, vec4(previous.rgb + sampleColor, previous.a + 1.0));
}
