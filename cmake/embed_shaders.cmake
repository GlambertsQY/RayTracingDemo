# 将指定目录下的所有 .spv 编译为 C++ 字节数组
# 调用方式：
#   cmake -DSPV_DIR=<dir> -DOUTPUT_CPP=<file> -P embed_shaders.cmake

if(NOT DEFINED SPV_DIR OR NOT DEFINED OUTPUT_CPP)
    message(FATAL_ERROR "SPV_DIR and OUTPUT_CPP are required")
endif()

file(GLOB SPV_FILES "${SPV_DIR}/*.spv")
list(SORT SPV_FILES)

set(CONTENT "// Generated by cmake/embed_shaders.cmake. Do not edit.\n\n")
set(CONTENT "${CONTENT}struct EmbeddedShader\n{\n    const char*          name;\n    const unsigned char* data;\n    unsigned int         size;\n};\n\n")

set(INDEX 0)
set(TABLE "")
foreach(SPV_FILE IN LISTS SPV_FILES)
    get_filename_component(SPV_NAME "${SPV_FILE}" NAME)
    file(READ "${SPV_FILE}" SPV_HEX HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," SPV_BYTES "${SPV_HEX}")
    string(LENGTH "${SPV_HEX}" HEX_LENGTH)
    math(EXPR SPV_SIZE "${HEX_LENGTH} / 2")

    string(APPEND CONTENT "static const unsigned char s_shader_${INDEX}[] = {${SPV_BYTES}};\n")
    string(APPEND TABLE "    {\"${SPV_NAME}\", s_shader_${INDEX}, ${SPV_SIZE}},\n")
    math(EXPR INDEX "${INDEX} + 1")
endforeach()

string(APPEND CONTENT "\nextern const EmbeddedShader g_embeddedShaders[] = {\n${TABLE}};\n")
string(APPEND CONTENT "extern const unsigned int g_embeddedShaderCount = ${INDEX};\n")

get_filename_component(OUTPUT_DIR "${OUTPUT_CPP}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_CPP}" "${CONTENT}")
